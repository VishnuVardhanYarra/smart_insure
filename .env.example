# Gemini API Credentials (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Flask Configuration
FLASK_SECRET_KEY=change-this-to-a-secure-random-string
FLASK_DEBUG=False
PORT=5000

# Database Configuration (Leave default for SQLite, or provide PostgreSQL URL on Render)
# DATABASE_URL=sqlite:///insuresmart.db

# Ngrok Configuration (Optional, only needed if running run_public.py locally)
# NGROK_AUTH_TOKEN=your_ngrok_token
